{
  "models": {
    "yolov8n": {
      "name": "yolov8n.onnx",
      "description": "YOLOv8 nano - COCO 80-class detection",
      "inputSize": [640, 640],
      "classes": 80,
      "source": "https://github.com/onnx/models/tree/main/vision/object_detection_segmentation/yolov8"
    },
    "yoloworld": {
      "name": "yoloworld.onnx",
      "description": "YOLO-World - Open vocabulary detection",
      "inputSize": [640, 640],
      "classes": "dynamic (text-conditioned)",
      "source": "https://github.com/TencentAI/Yolo-World"
    },
    "osnet": {
      "name": "osnet_x1_0.onnx",
      "description": "OSNet x1.0 - Person re-identification",
      "inputSize": [256, 128],
      "embeddingDim": 512,
      "source": "https://github.com/kaiyangzhou/deep-person-reid"
    },
    "clip_text": {
      "name": "clip_text_encoder.onnx",
      "description": "CLIP ViT-B/32 text encoder",
      "inputSize": [77],
      "embeddingDim": 512,
      "source": "https://github.com/openai/CLIP"
    }
  },
  "downloadInstructions": {
    "manual": "Download models manually and place in public/models/",
    "script": "Run: node scripts/download-models.js",
    "fallback": "App works with fallback embeddings if models missing"
  }
}